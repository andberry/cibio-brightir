{% extends "base/base.twig" %}
{% from "components/hero.twig" import hero %}
{% from "components/button.twig" import buttonHollow %}
{% from "components/goalcard.twig" import goalcard %}

{% block main %}
  {% if hero.image %}
    {{hero(hero.title, hero.subtitle, hero.image, '', '', hero.hero_size)}}
  {% endif %}
  
  <section class="c-container--small my-12 lg:my-24">
    <div class="prose prose-lg max-w-none">
      {{content}}
    </div>
  </section>

  
<section class="my-12 lg:my-24">
  <div class="max-w-[960px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

    {% for card in cards %}
      {% if card.brand_color == '1' %}
        <div class="bg-white rounded-[10px] border border-teal-100 overflow-hidden">
            <div class="h-[6px] bg-teal-500"></div>
            <div class="p-8">

              <h2 class="font-outfit font-bold text-xl tracking-tight text-teal-900 mb-2">
                {{card.c_title}}
              </h2>
              <div class="font-dmsans text-[13px] leading-[1.7] text-teal-700 mb-7">
                {{card.content}}
              </div>

              {% if card.email %}
                <div class="h-px bg-teal-100 mb-6"></div>
                
                <p class="font-dmsans font-semibold text-[10px] uppercase tracking-[.12em] text-teal-400 mb-1.5">
                  Email us at
                </p>
                <div class="flex items-center gap-2">
                  <svg class="w-[15px] h-[15px] stroke-teal-400 fill-none flex-shrink-0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                  </svg>
                  <a href="mailto:info@brightir.eu" class="font-dmsans font-medium text-sm text-teal-500 hover:underline">
                    {{card.email}}
                  </a>
                </div>
              {% endif %}

            </div>
          </div>
        {% else %}
        <div class="bg-white rounded-[10px] border border-teal-100 overflow-hidden">
        <div class="h-[6px] bg-yellow"></div>
        <div class="p-8">

          <h2 class="font-outfit font-bold text-xl tracking-tight text-teal-900 mb-2">
            {{card.c_title}}
          </h2>
          <div class="font-dmsans text-[13px] leading-[1.7] text-teal-700 mb-7">
            {{card.content}}
          </div>

          {% if card.email %}
            <div class="h-px bg-teal-100 mb-6"></div>

            <p class="font-dmsans font-semibold text-[10px] uppercase tracking-[.12em] text-yellow-dark mb-1.5">
              Email us at
            </p>
            <div class="flex items-center gap-2">
              <svg class="w-[15px] h-[15px] fill-none flex-shrink-0" stroke="#C4B000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <a href="mailto:investors@brightir.eu" class="font-dmsans font-medium text-sm text-yellow-dark hover:underline">
                {{card.email}}
              </a>
            </div>
          {% endif %}
        </div>
      </div>
      {% endif %}
    {% endfor %}

    </div>
  </div>
</section>
{% endblock %}