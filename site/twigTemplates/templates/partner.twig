{% extends "base/base.twig" %}
{% from "components/hero.twig" import hero %}
{% from "components/imagetextteam.twig" import imagetextteam %}
{% from "components/button.twig" import buttonHollow %}

{% block main %}
{{hero(pageTitle, "", hero.image, '', '', 'small')}}
  <section class="c-container--small pt-28 pb-12 md:pb-24 md:pt-36">
  
    <div class="flex flex-col gap-4 items-center text-center">
      <a target="_blank" href="{{url}}">
        <img src="{{logo.url}}" alt="{{logo.alt}}" class="w-52 flex-none">
      </a>
    </div>
      
    <div class="mt-16 prose max-w-none">
      {{content}}
    </div>
    {% if url %}
      <div class="mt-8 text-center">
        {% set websiteLinkText = "Go to " ~ pageTitle ~" website" %}
        <a target="_blank" class="hover:text-primary" href="{{url}}">{{websiteLinkText}}</a>
      </div>
    {% endif %}
  </section>
  
  {% if team|length > 0 %}
  <section class="c-container py-8 md:py-16">
    <h2 class="text-center">Team</h2>
    {% for item in team %}
      {{imagetextteam(item.c_title, item.c_text, item.c_image, item.image_position)}}
    {% endfor %}
    {% if url %}
      <div class="mt-16 text-center">
      {{buttonHollow('/partners/',"Back to Partners")}}
      </div>
    {% endif %}
  </section>
  {% endif %}
{% endblock %}