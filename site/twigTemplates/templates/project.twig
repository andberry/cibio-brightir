{% extends "base/base.twig" %}
{% from "components/hero.twig" import hero %}
{% from "components/button.twig" import buttonHollow %}
{% from "components/goalcard.twig" import goalcard %}

{% block main %}
  {% if hero.image %}
    {{hero(hero.title, hero.subtitle, hero.image, '', '', 'small')}}
  {% endif %}

  {# Goals #}
    <section class="bg-graylight py-12 lg:py-24">
      <div class="c-container--small">
        <div class="flex gap-2 items-center">
        <div class="h-[3px] w-7 bg-yellow"></div>
        <span class="eyebrow">Project Goals</span>
      </div>
      <h2 class="h2">What we want to achieve</h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 mt-8">
          {% for item in goals %}
            {{goalcard(item.number, item.title, item.pretitle, item.text, item.featured)}}
          {% endfor %}
        </div>
      </div>
    </section>
  
    <section class="c-container--small py-12 lg:py-24">
      <div class="prose prose-lg max-w-none">
        {{intro}}
      </div>
    </section>

    
{% endblock %}