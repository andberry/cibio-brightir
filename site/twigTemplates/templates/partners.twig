{% extends "base/base.twig" %}
{% from "components/hero.twig" import hero %}
{% from "components/button.twig" import buttonHollow %}
{% from "components/partnercard.twig" import partnercard %}

{% block main %}
  {% if hero.image %}
    {{hero(hero.title, hero.subtitle, hero.image, '', '', hero.hero_size)}}
  {% endif %}
  
  <section class="c-container--small my-12 lg:my-24">
    <div class="u-wysiwyg">
      {{content}}
    </div>
  </section>

  {# Partners list #}
  <section class="bg-graylight my-12 lg:my-24">
    <div class="c-container--small">
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2 mt-8">
        {% for item in partners %}
          {{partnercard(item.title, item.logo, item.url)}}
        {% endfor %}
      </div>
    </div>
  </section>
    
{% endblock %}