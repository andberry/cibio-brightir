{% extends "base/base.twig" %}
{% from "components/hero.twig" import hero %}
{% from "components/button.twig" import buttonHollow %}
{% from "components/partners.twig" import partnersGrid %}

{% block extrahead %}
  <script src='https://api.mapbox.com/mapbox-gl-js/v2.9.1/mapbox-gl.js'></script>
  <link href='https://api.mapbox.com/mapbox-gl-js/v2.9.1/mapbox-gl.css' rel='stylesheet' />
{% endblock %}

{% block main %}
  {% if hero.image %}
    {{hero(hero.title, hero.subtitle, hero.image)}}
  {% endif %}
  
  <section class="c-container--small py-12 lg:py-24">
    {# <h1 class="text-6xl font-bold mb-2">{{pageTitle}}</h1> #}
    <div class="text-center">
      Partners contributing to OMICSENS project
    </div>
  </section>

  <section>
    <div class="aspect-square lg:aspect-[5/2]">
      <div id='map' style='width: 100%; height: 100%;'></div>
    </div>

    <script>
      const mapPins = {{map.pins|json_encode}};
      mapboxgl.accessToken = 'pk.eyJ1IjoiYW5kYmVycnkiLCJhIjoiY2xyZjhocHU5MDJrZDJxb2J6eTRpMDRkeCJ9.iKAviDzwPmSjHizlEzlhcg';
      const map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/light-v11',
        projection: 'mercator',
        minZoom: 1,
        interactive: false
      });
      map.addControl(new mapboxgl.NavigationControl(), 'top-left');
      map.addControl(new mapboxgl.ScaleControl());

      // add markers
      const mapBounds = new mapboxgl.LngLatBounds();
      for (const pin of mapPins) {
        console.log(pin)
        new mapboxgl.Marker({color: pin.color})
          .setLngLat([pin.lng, pin.lat])
          //.setPopup(new mapboxgl.Popup().setHTML("<h1>Hello World!</h1>")) // add popup
          .setPopup(new mapboxgl.Popup().setHTML(`
          <h3 class="font-bold text-xl mt-0 pr-8 leading-none">
            <a href=${pin.url}>
              ${pin.title}
            </a>
          </h3>
          <div class="leading-tight">${pin.content}</div>
          <p class="mt-2">
            <a href=${pin.url} class="underline hover:no-underline">Go to Details Page</a>
          </p>
          `))
          .addTo(map);
        mapBounds.extend([pin.lng, pin.lat]);
      }
      map.fitBounds(mapBounds, {padding: 100, animate: false, maxZoom: 18});
    </script>
  </section>

  <section class="c-container--small py-12 lg:py-24">
    {{partnersGrid(partners)}}
  </section>
{% endblock %}