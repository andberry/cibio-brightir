{% extends "base/base.twig" %}
{% from "components/hero.twig" import hero %}
{% from "components/button.twig" import buttonHollow %}
{% from "components/imagetext.twig" import imagetext %}
{% from "components/partners.twig" import partnersGrid %}
{% from "components/highlightcard.twig" import highlightcard %}
{% from "components/goalcard.twig" import goalcard %}

{% block main %}
  {{hero(hero.title, hero.subtitle, hero.image, '', '', 'default', 1)}}

  {# Goals #}
  <section class="my-12 lg:my-48">
    <div class="c-container">
    <div class="flex gap-2 items-center">
      <div class="h-[3px] w-7 bg-yellow"></div>
      <span class="eyebrow">Project Goals</span>
    </div>
    <h2 class="h2">What we want to achieve</h2>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 mt-8">
      {% for item in goals %}
          {{goalcard(item.number, item.title, item.pretitle, item.text, item.featured)}}
        {% endfor %}
    </div>
    </div>
  </section>
    
  {# Image Text Section #}
  {% for item in imagetextsections %}
    {{imagetext(item.c_title, item.c_text, item.c_image, item.image_position)}}
  {% endfor %}
    
  {# Highlights #}
  {% if highlights|length > 0 %}
  <section class="bg-teal-800 py-16 px-10">
    <div class="c-container">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-5 h-[2px] bg-yellow"></div>
        <span class="font-dmsans font-semibold text-[10px] uppercase tracking-[.14em] text-teal-400 opacity-70">Latest News</span>
      </div>
      <h2 class="font-outfit font-bold text-[28px] tracking-tight text-white mb-8 leading-tight">
        Recent highlights
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {% for item in highlights %}
          {{highlightcard(item.url, item.title, item.subtitle, item.image)}}
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# Partners #}
  <section class="py-12 lg:py-24 bg-white">
    <div class="c-container">
      <div class="flex gap-24 items-center">
        <h2 class="h3">{{partners.title}}</h2>
        <div class="flex items-center gap-16">
          <div class="w-[160px]">
            <img src="/site/assets/files/images/unitrento-logo.jpg" alt="" class="w-full block">
          </div>
          <div class="w-[160px]">
            <img src="/site/assets/files/images/4k-mems-logo.png" alt="" class="w-full block">
          </div>
        </div>
      </div>
    </div>
  </section>
{% endblock %}