{% extends "base/base.twig" %}
{% from "components/hero.twig" import hero %}
{% from "components/button.twig" import buttonHollow %}

{% block main %}
  {% if hero.image %}
    {{hero(hero.title, hero.subtitle, hero.image)}}
  {% endif %}
  
  <section class="c-container--small pt-28 pb-12 md:pb-24 md:pt-36">
    <header class="mb-8">
      <h1>{{ pageTitle }}</h1>
      <time datetime="{{date}}" class="uppercase text-xs">{{datedisplay}}</time>
    </header>
    <div class="prose prose-lg max-w-none">
      {{ content }}
    </div>
    <footer class="mt-8">
      {{buttonHollow('/news-events/','Back to News list')}}
    </footer>
  </section>
{% endblock %}