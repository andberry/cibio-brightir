{% macro partnercard(title, logo, url) %}
	
<a href={{url}} class="block relative overflow-hidden rounded-md border border-teal-100 bg-white p-5 border-t-[3px] border-t-teal-500 text-center">
	<div class="flex flex-col items-center gap-8">
		<img src={{logo.url}} alt={{title}} class="block h-[60px] md:h-[40px] lg:h-[60px] w-auto">
		<h3 class="font-outfit font-medium mb-3 text-[15px] text-teal-900">
			{{title}}
		</h3>
	</div>
</a>

{% endmacro %}
