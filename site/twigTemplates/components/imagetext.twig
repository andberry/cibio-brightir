{% macro imagetext(title, text, image, imageposition) %}
	<section class="c-imagetext relative my-12 lg:mt-20 lg:mb-40 z-0 ">
	
		<div class="c-container">
			<div class="rounded-md border border-teal-100 overflow-hidden">
			<div class="lg:grid grid-cols-6">
			{% if imageposition == '2' %}
				<div class="col-span-3">
					<div class=" p-6 lg:p-8 xl:p-16 h-full lg:relative flex flex-col gap-4 justify-center">
						<div class="h-[3px] w-7 bg-yellow"></div>
						<p class="font-dmsans text-[12px] font-medium uppercase">
							About the project
						</p>
						<h3 class="h3 mb-4 mt-0">A new generation of broadband IR emitters for generalized sensing</h3>
						<div>BRIGHTIR brings together photonics researchers, MEMS engineers, and sensing specialists across Europe to develop foundational technology for next-generation IR sensing systems.</div>
					</div>
				</div>
				<div class="col-span-3 ">
					<img src="{{image.url}}" alt="" class="w-full h-full object-cover object-center ">
				</div>
			{% else %}
			<div class="col-span-3 ">
					<img src="{{image.url}}" alt="" class="w-full h-full object-cover object-center ">
				</div>
				<div class="col-span-3">
					<div class=" p-6 lg:p-8 xl:p-16 h-full lg:relative flex flex-col gap-4 justify-center">
						<div class="h-[3px] w-7 bg-yellow"></div>
						<p class="font-dmsans text-[10px] font-medium uppercase">
							About the project
						</p>
						<h3 class="font-outfit mb-4 text-2xl font-bold leading-tight tracking-tight mt-0">A new generation of broadband IR emitters for generalized sensing</h3>
						<div>BRIGHTIR brings together photonics researchers, MEMS engineers, and sensing specialists across Europe to develop foundational technology for next-generation IR sensing systems.</div>
					</div>
				</div>
			{% endif %}
			</div>
			</div>
		</div>
	</section>
{% endmacro %}
