{% macro imagetext(title, text, image, imageposition) %}
	<section class="c-imagetext relative py-12 lg:pt-20 lg:pb-40 z-0">
	
		<div class="c-container lg:grid grid-cols-6">
			{% if imageposition == '2' %}
				<div class="col-span-3 text-right">
					<div class="border-l-4 border-primary p-6 lg:p-8 xl:p-16 h-full lg:relative lg:top-24">
						<h3 class="mb-6 mt-0 u-bg-brand-gradient">{{title}}</h3>
						<div class="font-light">{{text}}</div>
					</div>
				</div>
				<div class="col-span-3">
					<img src="{{image.url}}" alt="" class="w-full h-full object-cover object-center rounded-bl-2xl rounded-tr-[100px]">
				</div>
			{% else %}
				<div class="col-span-3">
					<img src="{{image.url}}" alt="" class="w-full h-full object-cover object-center rounded-br-2xl rounded-tl-[100px]">
				</div>
				<div class="col-span-3">
					<div class="border-r-4 border-primary p-6 lg:p-8 xl:p-16 h-full lg:relative lg:top-24">
						<h3 class="mb-6 mt-0">{{title}}</h3>
						<div class="font-light">{{text}}</div>
					</div>
				</div>
			{% endif %}
		</div>
	</section>
{% endmacro %}
