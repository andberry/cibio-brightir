{% macro button(url,title) %}
  <a href={{url}} class="border-2 border-primary bg-primary text-white rounded-sm inline-flex justify-center items-center px-6 py-1 hover:bg-secondary hover:border-secondary transition-all duration-100 ease-linear">{{title}}</a>  
{% endmacro %}

{% macro buttonHollow(url,title) %}
  <a href={{url}} class="border-2 border-primary text-primary rounded-sm inline-flex justify-center items-center px-6 py-1 hover:bg-primary hover:text-white transition-all duration-100 ease-linear">{{title}}</a>  
{% endmacro %}

{% macro buttonTransparent(url,title) %}
  <a href={{url}} class="text-primary rounded-sm inline-flex justify-center items-center px-6 py-1 transition-all duration-100 ease-linear">{{title}}</a>  
{% endmacro %}


{% macro ctaLink(url,title) %}
  <a href={{url}} class="inline-flex gap-2 items-center px-3 py-2 transition-all duration-100 ease-linear group uppercase">
    {{title}}
    <svg class="group-hover:translate-x-1 ease-out duration-200 transition-all" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M16.01 11H4v2h12.01v3L20 12l-3.99-4z"/></svg>
  </a>  
{% endmacro %}