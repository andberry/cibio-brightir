<footer id="page-footer" class="text-sm">
  <div class="bg-teal-200">
    <div class="c-container--large py-4 md:py-12 flex flex-col justify-center gap-8 lg:gap-16 lg:flex-row lg:justify-between lg:items-center ">
      <div class="flex-1 u-wysiwyg text-center md:text-left">{{settings.c_text}}</div>
      <div class="flex gap-6 lg:w-1/2 justify-center lg:justify-end flex-none flex-wrap">
        <img src="{{settings.logo.src}}" alt="" class="h-[40px]">
        <div class="flex gap-6">
          {% for item in settings.logos %}
            <img src="{{item.src}}" alt="" class="h-[40px]">
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <div class="text-sm bg-teal-900 text-white py-4">
    <div class="c-container--large md:flex justify-between items-center">
      <div>
        {{settings.copyright}}
      </div>
      
      <div class="md:flex justify-end items-center gap-12">
        {% if footerMenu|length > 0 %}
          <nav class="border border-[tomato]">
            <ul class="list-none flex gap-4">
              {% for item in footerMenu %}
                <li>
                  <a class="underline underline-offset-4 hover:decoration-pink transition-all duration-200 ease-linear" href="{{item.link_url}}" {% if item.link_blank %}target="_blank"{% endif %}>{{item.title}}</a>
                </li>
              {% endfor %}
            </ul>
          </nav>
          <span>|</span>
        {% endif %}
        <div>
          <nav>
            <ul class="list-none md:flex gap-3 m-0 md:text-center items-center">
              <li class="flex gap-2 items-center p-0">
                <p>
                  <a href="mailto:{{settings.contacts_email}}">{{settings.contacts_email}}</a>
                </p>
              </li>
              {% if settings.privacy_file %}
              <li class="p-0">
                <span class="hidden md:inline-block">|</span>
              </li>
              {% endif %}
              {% if settings.privacy_file %}
                <li class="p-0">
                  <a href="{{settings.privacy_file.url}}" target="_blank">Privacy</a>
                </li>
              {% endif %}
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
</footer>