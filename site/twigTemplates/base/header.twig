<header id="page-header" class="py-1 fixed top-0 inset-x-0 bg-white z-10 uppercase shadow-md">
  <div class="c-container flex justify-between items-center">
    {# Logo and nav #}
    <div class="flex items-center gap-8">
    <div class="w-48 md:w-64">
      <a href="/">
        <img src="{{settings.logo.src}}" alt="" class="w-full">
        {# <img src="{{urls.img}}/omicsens-logo-2.png" alt="Logo" class="w-full"> #}
      </a>
    </div>
    
    {# Desktop Nav #}
    <div class="hidden lg:block">
      <nav>
        <ul class="list-none flex gap-3 xl:gap-8 m-0 text-center">
          {% for item in mainMenu %}
            <li class="group relative m-0 p-0">
              <a href="{{item.link_url}}"
              class="hover:text-primary ease-linear transition-all duration-100 p-2 block text-sm xl:text-base"
                {% if item.link_blank %}target="_blank"{% endif %}
                {% if item.link_url == page.url %} class="is-active" {% endif %}
              >
                {{item.title}}
              </a>

              {# Submenu #}
              {% if item.numChildren %}
                <ul class="list-none flex-col gap-4 m-0 bg-white p-6 flex absolute top-full left-0 w-[250px] rounded-sm transition-all duration-200 ease-out translate-y-2 group-hover:translate-y-0 invisible opacity-0 group-hover:visible group-hover:opacity-100">
                {% for subitem in item.children %}
                  <li class="m-0 p-0 text-left">
                    <a href="{{subitem.link_url}}"
                    class="hover:text-secondary ease-linear transition-all duration-200"
                      {% if subitem.link_blank %}target="_blank"{% endif %}
                      {% if subitem.link_url == page.url %} class="is-active" {% endif %}
                    >
                      {{subitem.title}}
                    </a>
                  </li>
                {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav> 
    </div>
    </div>

    {# Mobile menu triggered by a peer hidden checkbox #}
    {# Working as everything is inside the label that triggers the checkbox #}
    <div class="lg:hidden">
      <label>
        <input type="checkbox" class="peer hidden" id="mobile-menu-trigger">
        <div class="w-10 md:w-14 peer-checked:opacity-0 ease-linear transition-all duration-200 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-full fill-primary" viewBox="0 0 24 24">
            <path d="M4 17.27v-1h16v1zm0-4.77v-1h16v1zm0-4.77v-1h16v1z"/>
          </svg>
          <div class="text-xs text-center -top-2 relative peer-checked:opacity-0 ease-linear transition-all duration-200">Menu</div>
        </div>
        
        {# Overlay black/blur #}
        <div class="opacity-0 peer-checked:opacity-100 fixed invisible peer-checked:visible inset-0 z-20 bg-black/50 backdrop-blur-sm transition-all ease-linear duration-200 overscroll-y-none"></div>
        
        {# Mobile Menu #}
        <div class="invisible peer-checked:visible flex flex-col fixed xl:hidden h-screen bg-white w-[80vw] top-0 right-0 z-30 transition-all ease-out duration-300 translate-x-full peer-checked:translate-x-0 overscroll-y-contain overflow-y-auto">
         
         {# Close Menu icon #}
          <div class="c-container flex justify-end flex-shrink-0 w-full py-3">
            <div>
              <div class="w-10 md:w-14">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-full fill-primary" viewBox="0 0 24 24"><path d="m6.4 18.308l-.708-.708l5.6-5.6l-5.6-5.6l.708-.708l5.6 5.6l5.6-5.6l.708.708l-5.6 5.6l5.6 5.6l-.708.708l-5.6-5.6z"/></svg>
              </div>
              <div class="text-xs text-center -top-2 relative">Close</div>
            </div>
          </div>
          <nav class="flex flex-col items-start justify-start flex-grow py-8 overflow-y-auto overscroll-y-none">
            <ul class="list-none flex gap-2 flex-col m-0 pl-8 md:pl-16">
              {% for item in mainMenu %}
                <li class="m-0 p-0">
                  <a href="{{item.link_url}}"
                  class="md:text-2xl py-2 block leading-none"
                    {% if item.link_blank %}target="_blank"{% endif %}
                    {% if item.link_url == page.url %} class="is-active" {% endif %}
                  >
                    {{item.title}}
                  </a>
                  
                  {# Submenu #}
                  {% if item.numChildren %}
                  <ul class="list-none flex flex-col gap-2 m-0 p-0 mt-4 pl-4">
                  {% for subitem in item.children %}
                    <li class="m-0 p-0 text-left">
                      <a href="{{subitem.link_url}}"
                      class="md:text-xl"
                        {% if subitem.link_blank %}target="_blank"{% endif %}
                        {% if subitem.link_url == page.url %} class="is-active" {% endif %}
                      >
                        {{subitem.title}}
                      </a>
                    </li>
                  {% endfor %}
                  </ul>
                {% endif %}
                </li>
              {% endfor %}
            </ul>
          </nav>  
        </div>
      </label>
    </div>
    
  </div>
</header>